<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="PrimaryColor"
                     Color="#4A1E1E" />
    <SolidColorBrush x:Key="PrimaryLight"
                     Color="#6E2E2E" />
    <SolidColorBrush x:Key="PrimaryLighter"
                     Color="#E8D4D4" />
    <SolidColorBrush x:Key="PrimaryDark"
                     Color="#2B1010" />

    <SolidColorBrush x:Key="TextWhite"
                     Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextLight"
                     Color="#ECEFF1" />
    <SolidColorBrush x:Key="TextGray"
                     Color="#90A4AE" />
    <SolidColorBrush x:Key="DividerColor"
                     Color="#5E3E3E" />

    <Color x:Key="SidebarGradStart">#3E1B1B</Color>
    <Color x:Key="SidebarGradEnd">#2A1111</Color>

    <SolidColorBrush x:Key="MainContainerBg"
                     Color="#342626" />

    <Color x:Key="WindowGradStart">#3A2B2B</Color>
    <Color x:Key="WindowGradMedium">#2F2222</Color>
    <Color x:Key="WindowGradEnd">#251A1A</Color>

    <Color x:Key="SrcColor_PrimaryColor">#4A1E1E</Color>
    <Color x:Key="SrcColor_PrimaryDark">#2B1010</Color>
    <Color x:Key="SrcColor_MainText">#ECEFF1</Color>
    <Color x:Key="SrcColor_TextGray">#90A4AE</Color>
    <Color x:Key="SrcColor_TextWhite">#FFFFFF</Color>
    <Color x:Key="SrcColor_MainContainerBg">#342626</Color>
    <Color x:Key="SrcColor_PrimaryLighter">#3E1B1B</Color>
    <Color x:Key="SrcColor_DividerColor">#5E3E3E</Color>
    <SolidColorBrush x:Key="MainTextColor"
                     Color="#ECEFF1" />
</ResourceDictionary>