<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Style nền tảng cho các khối nội dung (Main Content) -->
    <Style x:Key="GlassContainerBase"
           TargetType="Border">
        <!-- Đổi từ nền kính mờ sang màu trắng đặc -->
        <Setter Property="Background"
                Value="White" />
        <!-- Viền xám nhạt tinh tế -->
        <Setter Property="BorderBrush"
                Value="#E0E0E0" />
    </Style>

    <!-- Style cho khu vực Menu bên trái (Sidebar) -->
    <Style x:Key="SidebarContainerStyle"
           TargetType="Border">
        <Setter Property="CornerRadius"
                Value="40,15,15,40" />
        <!-- Đổi sang màu xanh lá đậm đặc -->
        <Setter Property="Background"
                Value="#2E7D32" />
    </Style>

    <!-- Style cho khu vực nội dung bên phải -->
    <Style x:Key="MainContainerStyle"
           BasedOn="{StaticResource GlassContainerBase}"
           TargetType="Border">
        <Setter Property="CornerRadius"
                Value="15,40,40,15" />
    </Style>

    <!-- Style cho viền bọc ngoài vùng nội dung chính -->
    <Style x:Key="BorderContainerStyle"
           TargetType="Border">
        <Setter Property="CornerRadius"
                Value="15,40,40,15" />
        <!-- Viền màu xanh lá để đồng bộ -->
        <Setter Property="BorderBrush"
                Value="#4CAF50" />
        <Setter Property="BorderThickness"
                Value="2" />
        <!-- Thêm đổ bóng nhẹ để tạo chiều sâu cho khối trắng -->
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.1" Color="Black" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Style cho viền bọc ngoài Sidebar -->
    <Style x:Key="BorderSidebarStyle"
           TargetType="Border">
        <Setter Property="CornerRadius"
                Value="40,15,15,40" />
        <!-- Viền xanh lá đậm hơn cho Sidebar -->
        <Setter Property="BorderBrush"
                Value="#1B5E20" />
        <Setter Property="BorderThickness"
                Value="2" />
    </Style>
</ResourceDictionary>