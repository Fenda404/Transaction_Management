<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="PrimaryColor"
                     Color="#152B46" />
    <SolidColorBrush x:Key="PrimaryLight"
                     Color="#224573" />
    <SolidColorBrush x:Key="PrimaryLighter"
                     Color="#D0E1F3" />
    <SolidColorBrush x:Key="PrimaryDark"
                     Color="#0D1B2A" />

    <SolidColorBrush x:Key="TextWhite"
                     Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextLight"
                     Color="#ECEFF1" />
    <SolidColorBrush x:Key="TextGray"
                     Color="#90A4AE" />
    <SolidColorBrush x:Key="DividerColor"
                     Color="#3E4E5E" />

    <Color x:Key="SidebarGradStart">#12253F</Color>
    <Color x:Key="SidebarGradEnd">#0B1829</Color>

    <SolidColorBrush x:Key="MainContainerBg"
                     Color="#1F2A38" />

    <Color x:Key="WindowGradStart">#243042</Color>
    <Color x:Key="WindowGradMedium">#1C2634</Color>
    <Color x:Key="WindowGradEnd">#151D28</Color>

    <Color x:Key="SrcColor_PrimaryColor">#152B46</Color>
    <Color x:Key="SrcColor_PrimaryDark">#0D1B2A</Color>
    <Color x:Key="SrcColor_MainText">#ECEFF1</Color>
    <Color x:Key="SrcColor_TextGray">#90A4AE</Color>
    <Color x:Key="SrcColor_TextWhite">#FFFFFF</Color>
    <Color x:Key="SrcColor_MainContainerBg">#1F2A38</Color>
    <Color x:Key="SrcColor_PrimaryLighter">#12253F</Color>
    <Color x:Key="SrcColor_DividerColor">#3E4E5E</Color>
    <SolidColorBrush x:Key="MainTextColor"
                     Color="#ECEFF1" />
</ResourceDictionary>