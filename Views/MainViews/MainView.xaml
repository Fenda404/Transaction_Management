<Window x:Class="Transaction_Management.Views.MainViews.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Transaction_Management.ViewModels"
        xmlns:uc="clr-namespace:Transaction_Management.Views.UserControls"
        mc:Ignorable="d"
        Title="Hệ thống Quản lý chi tiêu cá nhân"
        Height="800"
        Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- MAPPING: Định nghĩa View nào sẽ hiển thị cho ViewModel nào -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <uc:Dashboard_UC />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TransactionsViewModel}">
            <uc:Transactions_UC />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <uc:Reports_UC />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BudgetsViewModel}">
            <uc:Budgets_UC />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <uc:Settings_UC />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- NỀN GRADIENT TOÀN CỬA SỔ -->
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="1,1">
                    <GradientStop Color="#FFFFFF"
                                  Offset="0.0" />
                    <GradientStop Color="#F1F8E9"
                                  Offset="0.5" />
                    <GradientStop Color="#C8E6C9"
                                  Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <!-- Sidebar -->
                <ColumnDefinition Width="*" />
                <!-- Main Content -->
            </Grid.ColumnDefinitions>

            <!-- 1. SIDEBAR (THANH ĐIỀU HƯỚNG BÊN TRÁI) -->
            <Border Grid.Column="0"
                    Style="{StaticResource BorderSidebarStyle}"
                    Margin="0,0,15,0">
                <Border Style="{StaticResource SidebarContainerStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <!-- Info User -->
                            <RowDefinition Height="*" />
                            <!-- Menu -->
                            <RowDefinition Height="Auto" />
                            <!-- Footer/Logout -->
                        </Grid.RowDefinitions>

                        <!-- Avatar & Profile -->
                        <WrapPanel Grid.Row="0"
                                   Margin="30,40,0,30">
                            <Border Width="90"
                                    Height="90"
                                    CornerRadius="45"
                                    Background="#33FFFFFF"
                                    BorderBrush="White"
                                    BorderThickness="2"
                                    Margin="0,0,0,15">
                                <TextBlock Text="&#xE77B;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="50"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center"
                                        Margin="5,0,0,0">
                            <TextBlock Text="{Binding GetRoleName}"
                                       Foreground="White"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="10,0" />
                            <TextBlock Text="{Binding GetUsername}"
                                       Foreground="White"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="10,0" />
                            </StackPanel>
                        </WrapPanel>

                        <!-- Menu Buttons -->
                        <StackPanel Grid.Row="1"
                                    Margin="10,0"
                                    >
                            <Button Style="{StaticResource SidebarButtonStyle}"
                                    Content="TỔNG QUAN"
                                    Command="{Binding SwitchViewCommand}"
                                    CommandParameter="Dashboard" 
                                    Margin="0,10,0,10"
                                    FontSize="24"/>

                            <Button Style="{StaticResource SidebarButtonStyle}"
                                    Content="GIAO DỊCH"
                                    Command="{Binding SwitchViewCommand}"
                                    CommandParameter="Transactions"
                                    Margin="0,10,0,10"
                                    FontSize="24" />

                            <Button Style="{StaticResource SidebarButtonStyle}"
                                    Content="BÁO CÁO"
                                    Command="{Binding SwitchViewCommand}"
                                    CommandParameter="Reports"
                                    Margin="0,10,0,10"
                                    FontSize="24"/>

                            <Button Style="{StaticResource SidebarButtonStyle}"
                                    Content="NGÂN SÁCH"
                                    Command="{Binding SwitchViewCommand}"
                                    CommandParameter="Budgets"
                                    Margin="0,10,0,10" 
                                    FontSize="24"/>

                            <Button Style="{StaticResource SidebarButtonStyle}"
                                    Content="CÀI ĐẶT"
                                    Command="{Binding SwitchViewCommand}"
                                    CommandParameter="Settings"
                                    Margin="0,10,0,10"
                                    FontSize="24"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>

            <!-- 2. NỘI DUNG CHÍNH (KHUNG TRẮNG BÊN PHẢI) -->
            <Border Grid.Column="1"
                    Style="{StaticResource BorderContainerStyle}">
                <Border Style="{StaticResource MainContainerStyle}">
                    <Grid>
                        <!-- NƠI HIỂN THỊ CÁC USERCONTROL TƯƠNG ỨNG VỚI CURRENT VIEW -->
                        <ContentControl Content="{Binding CurrentView}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Margin="5" />
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>