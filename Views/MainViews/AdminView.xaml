<Window x:Class="Transaction_Management.Views.MainViews.AdminView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Transaction_Management.ViewModels"
        mc:Ignorable="d"
        Title="Admin"
        d:DesignHeight="600"
        d:DesignWidth="1000">

    <Window.DataContext>
        <vm:AdminViewModel />
    </Window.DataContext>

    <Window.Resources>
        <ImageBrush x:Key="HighContrastBackground"
                    ImageSource="/Resources/Images/Backgrounds/background_01.jpg"
                    Stretch="UniformToFill" />

        <Style x:Key="AdminCardStyle"
               TargetType="Border">
            <Setter Property="Background"
                    Value="White" />
            <Setter Property="CornerRadius"
                    Value="16" />
            <Setter Property="Padding"
                    Value="20" />
            <Setter Property="BorderBrush"
                    Value="#E0E0E0" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12"
                                      ShadowDepth="1"
                                      Opacity="0.06"
                                      Color="Black" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AdminInputStyle"
               TargetType="TextBox">
            <Setter Property="Height"
                    Value="40" />
            <Setter Property="FontSize"
                    Value="14" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="Padding"
                    Value="10,0" />
            <Setter Property="Margin"
                    Value="0,0,0,12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="White"
                                BorderBrush="#A5D6A7"
                                BorderThickness="1.5"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AdminDataGridHeaderStyle"
               TargetType="DataGridColumnHeader">
            <Setter Property="Background"
                    Value="#4CAF50" />
            <Setter Property="Foreground"
                    Value="White" />
            <Setter Property="Padding"
                    Value="12,10" />
            <Setter Property="FontWeight"
                    Value="Bold" />
            <Setter Property="FontSize"
                    Value="18" />
            <Setter Property="BorderThickness"
                    Value="0,0,1,0" />
            <Setter Property="BorderBrush"
                    Value="#388E3C" />
        </Style>
    </Window.Resources>

    <Grid Background="White">

        <Grid Background="{StaticResource HighContrastBackground}"
              Opacity="1">
            <Grid.Effect>
                <BlurEffect Radius="10"
                            RenderingBias="Quality" />
            </Grid.Effect>
        </Grid>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Margin="0,20,0,0">
                <TextBlock Text="QUẢN TRỊ VIÊN"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#2E7D32"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Quản lý thông tin tài khoản thành viên, thực hiện phân quyền hệ thống"
                           Foreground="#757575"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0" />
            </StackPanel>

            <Grid Grid.Row="1"
                  Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="380" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0"
                      Margin="0,0,20,0">
                    <Border Style="{StaticResource AdminCardStyle}">
                        <DataGrid ItemsSource="{Binding UserList}"
                                  SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  RowHeight="50"
                                  HeadersVisibility="Column"
                                  IsReadOnly="True"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F1F1F1"
                                  AlternatingRowBackground="#F9FDF9">

                            <DataGrid.Resources>
                                <Style TargetType="ScrollViewer">
                                    <Style.Resources>
                                        <Style TargetType="ScrollBar"
                                               BasedOn="{StaticResource CustomScrollBarStyle}" />
                                    </Style.Resources>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader"
                                       BasedOn="{StaticResource AdminDataGridHeaderStyle}" />
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="MÃ SỐ (ID)"
                                                    Binding="{Binding UserID}"
                                                    Width="*"
                                                    FontSize="18" />
                                <DataGridTextColumn Header="TÊN ĐĂNG NHẬP"
                                                    Binding="{Binding Username}"
                                                    Width="*"
                                                    FontSize="18" />
                                <DataGridTextColumn Header="ĐỊA CHỈ EMAIL"
                                                    Binding="{Binding Email}"
                                                    Width="*"
                                                    FontSize="18" />
                                <DataGridTextColumn Header="MÃ QUYỀN (ROLE)"
                                                    Binding="{Binding RoleID}"
                                                    Width="*"
                                                    FontSize="18" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <Grid Grid.Column="1">
                    <Border Style="{StaticResource AdminCardStyle}"
                            VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Tên đăng nhập (Username)"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"
                                       Foreground="#333" />
                            <TextBox Style="{StaticResource AdminInputStyle}"
                                     Text="{Binding FormUsername, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Địa chỉ Email"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"
                                       Foreground="#333" />
                            <TextBox Style="{StaticResource AdminInputStyle}"
                                     Text="{Binding FormEmail, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Mật khẩu (Khởi tạo/Cập nhật)"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"
                                       Foreground="#333" />
                            <TextBox Style="{StaticResource AdminInputStyle}"
                                     Text="{Binding FormPassword, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Cấp quyền tài khoản"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"
                                       Foreground="#333" />
                            <ComboBox Height="40"
                                      Margin="0,0,0,20"
                                      SelectedIndex="{Binding FormRoleIndex}">
                                <ComboBoxItem Content="Quản trị viên (Admin - 1)" />
                                <ComboBoxItem Content="Thành viên (User - 2)" />
                            </ComboBox>

                            <Button Content="TẠO TÀI KHOẢN MỚI"
                                    Height="42"
                                    Background="#2E7D32"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    Command="{Binding CreateUserCommand}"
                                    Margin="0,0,0,10"
                                    Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius"
                                                Value="8" />
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Content="CẬP NHẬT"
                                        Height="38"
                                        Background="#4CAF50"
                                        Foreground="White"
                                        FontWeight="SemiBold"
                                        Command="{Binding UpdateRoleCommand}"
                                        Margin="0,0,5,0"
                                        Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius"
                                                    Value="6" />
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <Button Grid.Column="1"
                                        Content="XÓA TÀI KHOẢN"
                                        Height="38"
                                        Background="#D32F2F"
                                        Foreground="White"
                                        FontWeight="SemiBold"
                                        Command="{Binding DeleteUserCommand}"
                                        Margin="5,0,0,0"
                                        Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius"
                                                    Value="6" />
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>

                            <Button Content="ĐĂNG XUẤT"
                                    Height="42"
                                    Background="LightCoral"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    Command="{Binding SignOutCommand}"
                                    Margin="0,10,0,0"
                                    Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius"
                                                Value="8" />
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <TextBlock Grid.Row="2"
                       Text="© 2026 Team 10. All rights reserved."
                       HorizontalAlignment="Center"
                       Foreground="#9E9E9E"
                       FontSize="12"
                       Margin="0,0,0,15" />
        </Grid>
    </Grid>
</Window>