<Window x:Class="Transaction_Management.Views.SubViews.AddTransaction"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Transaction_Management.ViewModels"
        mc:Ignorable="d"
        Height="500" Width="500"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        x:Name="AddTransactionWindow">
    <Window.DataContext>
        <vm:AddTransactionViewModel />
    </Window.DataContext>
    <Window.Resources>
        <!-- Style Label -->
        <Style x:Key="LabelStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="#2E7D32" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Margin"
                    Value="0,0,0,5" />
            <Setter Property="FontSize"
                    Value="13" />
        </Style>

        <!-- Style TextBox bo góc -->
        <Style TargetType="TextBox">
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="Padding"
                    Value="10,5" />
            <Setter Property="BorderBrush"
                    Value="#E0E0E0" />
            <Setter Property="Background"
                    Value="#F9FBF9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="false" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused"
                                     Value="True">
                                <Setter TargetName="border"
                                        Property="BorderBrush"
                                        Value="#4CAF50" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style ComboBox bo góc -->
        <Style TargetType="ComboBox">
            <Setter Property="Height"
                    Value="40" />
            <Setter Property="Margin"
                    Value="0,0,0,15" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="Padding"
                    Value="10,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border CornerRadius="8"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                Background="#F9FBF9">
                            <Grid>
                                <ToggleButton x:Name="ToggleButton"
                                              BorderThickness="0"
                                              Background="Transparent"
                                              ClickMode="Press"
                                              Focusable="false"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ContentPresenter x:Name="ContentSite"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  Margin="10,3,23,3"
                                                  VerticalAlignment="Center" />
                                <Path x:Name="Arrow"
                                      Fill="#2E7D32"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0"
                                      Data="M 0 0 L 4 4 L 8 0 Z" />
                                <Popup x:Name="Popup"
                                       Placement="Bottom"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Slide">
                                    <Border x:Name="DropDownBorder"
                                            Background="White"
                                            BorderBrush="#4CAF50"
                                            BorderThickness="1"
                                            CornerRadius="5">
                                        <ScrollViewer Margin="4,6,4,6"
                                                      SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True"
                                                        KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="White"
            CornerRadius="25"
            Margin="15">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                              Direction="-90"
                              ShadowDepth="2"
                              Opacity="0.15" />
        </Border.Effect>

        <Grid Margin="30,25,30,25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- Header -->
                <RowDefinition Height="*" />
                <!-- Form Scroll -->
                <RowDefinition Height="Auto" />
                <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <StackPanel Grid.Row="0"
                        Margin="0,0,0,20">
                <TextBlock Text="Thêm Giao Dịch Mới"
                           HorizontalAlignment="Center"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#1B5E20" />
                <TextBlock Text="Kiểm soát nguồn tiền của bạn tốt hơn"
                           HorizontalAlignment="Center"
                           Foreground="LightGray"
                           FontWeight="Bold"
                           FontSize="11"
                           />
                
            </StackPanel>

            <!-- 2. Form -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">
                    <!-- Số tiền (Amount) -->
                    <TextBlock Text="Số tiền (Amount)"
                               Style="{StaticResource LabelStyle}" />
                    <TextBox x:Name="txtAmount"
                             Height="45"
                             Margin="0,0,0,15"
                             FontSize="18"
                             FontWeight="Bold"
                             Foreground="#2E7D32"
                             VerticalContentAlignment="Center"
                             Text="{Binding Amount}"/>

                    <!-- Chọn Ví (WalletID) -->
                    <TextBlock Text="Chọn ví (Wallet)"
                               Style="{StaticResource LabelStyle}" />
                    <ComboBox x:Name="cbWallet"
                              DisplayMemberPath="WalletName"
                              SelectedValuePath="WalletName"
                              ItemsSource="{Binding Wallets}"
                              SelectedValue="{Binding Wallet}">
                        <!-- WalletID 1: Ví chính, 2: Tiết kiệm... -->
                    </ComboBox>

                    <!-- Danh mục (CategoryID) -->
                    <TextBlock Text="Danh mục (Category)"
                               Style="{StaticResource LabelStyle}" />
                    <ComboBox x:Name="cbCategory"
                              ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding Category}"
                            >
                        <!-- CategoryID 1: Lương, 2: Ăn uống... -->
                    </ComboBox>

                    <!-- Ngày giao dịch (TransactionDate) -->
                    <TextBlock Text="Ngày giao dịch"
                               Style="{StaticResource LabelStyle}" />
                    <DatePicker x:Name="dpDate"
                                Height="40"
                                Margin="0,0,0,15"
                                VerticalContentAlignment="Center"
                                SelectedDate="{Binding Date}">
                        <DatePicker.Resources>
                            <Style TargetType="DatePickerTextBox">
                                <Setter Property="IsReadOnly"
                                        Value="True" />
                                <Setter Property="Background"
                                        Value="Transparent" />
                                <Setter Property="BorderThickness"
                                        Value="0" />
                            </Style>
                        </DatePicker.Resources>
                    </DatePicker>

                    <!-- Ghi chú (Note) -->
                    <TextBlock Text="Ghi chú (Note)"
                               Style="{StaticResource LabelStyle}" />
                    <TextBox x:Name="txtNote"
                             Height="70"
                             VerticalContentAlignment="Top"
                             Padding="10"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Margin="0,0,0,15" 
                             Text="{Binding Description}"/>

                    <!-- Hình ảnh hóa đơn (ReceiptImage - Tùy chọn) -->
                    <Button Content="📁 Tải lên ảnh hóa đơn"
                            Background="#F1F8E9"
                            Foreground="#2E7D32"
                            BorderBrush="#C8E6C9"
                            BorderThickness="1"
                            Height="35"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius"
                                        Value="8" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <!-- 3. Footer -->
            <Grid Grid.Row="2"
                  Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Content="HỦY BỎ"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="Gray"
                        FontWeight="SemiBold"
                        Cursor="Hand" 
                        Command="{Binding CancelCommand}"
                        CommandParameter="{Binding ElementName=AddTransactionWindow}" />

                <Button Content="LƯU GIAO DỊCH"
                        Grid.Column="1"
                        Height="45"
                        Background="#2E7D32"
                        Foreground="White"
                        FontSize="14"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Command="{Binding SaveCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="22">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
