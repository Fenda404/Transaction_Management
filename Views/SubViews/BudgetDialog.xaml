<Window x:Class="Transaction_Management.Views.SubViews.BudgetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" Background="Transparent" AllowsTransparency="True"
        Title="Thiết lập ngân sách" Height="320" Width="400" WindowStartupLocation="CenterScreen">
    <Border Background="White" CornerRadius="16" BorderBrush="#2E7D32" BorderThickness="1.5" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.1"/>
        </Border.Effect>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="THIẾT LẬP HẠN MỨC NGÂN SÁCH" FontSize="16" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Center"/>

            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock Text="Chọn Hạng mục Chi tiêu" Margin="0,0,0,5" FontWeight="SemiBold"/>
                <ComboBox x:Name="cbCategory" Height="38" DisplayMemberPath="CategoryName" SelectedValuePath="CategoryID"/>

                <TextBlock Text="Hạn mức mong muốn (đ)" Margin="0,15,0,5" FontWeight="SemiBold"/>
                <TextBox x:Name="txtLimit" Height="38" VerticalContentAlignment="Center" FontSize="15" FontWeight="Bold" Foreground="#2E7D32" Padding="5,0"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="HỦY BỎ" Width="80" Height="32" Background="Transparent" BorderThickness="0" Foreground="Gray" Click="Cancel_Click" Margin="0,0,10,0" Cursor="Hand"/>
                <Button Content="XÁC NHẬN" Width="100" Height="32" Background="#2E7D32" Foreground="White" FontWeight="Bold" Click="Save_Click" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>