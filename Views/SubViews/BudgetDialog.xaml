<Window x:Class="Transaction_Management.Views.SubViews.BudgetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Transaction_Management.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        Title="{Binding DialogTitle}"
        Height="320"
        Width="400"
        d:DataContext="{d:DesignInstance Type=vm:BudgetDialogViewModel, IsDesignTimeCreatable=False}"
        WindowStartupLocation="CenterScreen">

    <Border Background="White"
            CornerRadius="16"
            BorderBrush="#2E7D32"
            BorderThickness="1.5"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10"
                              ShadowDepth="1"
                              Opacity="0.1" />
        </Border.Effect>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{Binding DialogTitle}"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="#2E7D32"
                       HorizontalAlignment="Center" />

            <StackPanel Grid.Row="1"
                        VerticalAlignment="Center">
                <TextBlock Text="Chọn Hạng mục Chi tiêu"
                           Margin="0,0,0,5"
                           FontWeight="SemiBold" />

                <ComboBox x:Name="cbCategory"
                          Height="38"
                          ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding SelectedCategory}"
                          DisplayMemberPath="CategoryName"
                          SelectedValuePath="CategoryID" />

                <TextBlock Text="Hạn mức mong muốn (đ)"
                           Margin="0,15,0,5"
                           FontWeight="SemiBold" />

                <TextBox x:Name="txtLimit"
                         Text="{Binding CurrentBudget.AmountLimit, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:G0}}"
                         Height="38"
                         VerticalContentAlignment="Center"
                         FontSize="15"
                         FontWeight="Bold"
                         Foreground="#2E7D32"
                         Padding="5,0" />
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="HỦY BỎ"
                        Command="{Binding CancelCommand}"
                        Width="80"
                        Height="32"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="Gray"
                        Margin="0,0,10,0"
                        Cursor="Hand" 
                        />

                <Button Content="XÁC NHẬN"
                        Width="100"
                        Height="32"
                        Background="#2E7D32"
                        Foreground="White"
                        FontWeight="Bold"
                        Command="{Binding SaveCommand}"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius"
                                    Value="4" />
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>