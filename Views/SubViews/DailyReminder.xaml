<Window x:Class="Transaction_Management.Views.SubViews.DailyReminder"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Transaction_Management.Views.SubViews"
        mc:Ignorable="d"
        Title="Nhắc Nhở Hàng Ngày"
        Height="220"
        Width="400"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Background="#FFFFFF"
            CornerRadius="12"
            BorderThickness="1"
            BorderBrush="#E2E8F0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15"
                              Direction="270"
                              RenderingBias="Quality"
                              ShadowDepth="2"
                              Opacity="0.1" />
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Margin="0,0,0,10">
                <Path Data="M19,3H14.82C14.4,1.84 13.3,1 12,1C10.7,1 9.6,1.84 9.18,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M12,3A1,1 0 0,1 13,4A1,1 0 0,1 12,5A1,1 0 0,1 11,4A1,1 0 0,1 12,3M14,17H7V15H14V17M17,13H7V11H17V13M17,9H7V7H17V9Z"
                      Fill="#2E7D32"
                      Width="28"
                      Height="28"
                      Stretch="Uniform"
                      Margin="0,0,10,0" />
                <TextBlock Text="Nhắc Nhở Ghi Chép Chi Tiêu"
                           Foreground="#2E7D32"
                           FontWeight="Bold"
                           FontSize="16"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Row="1"
                       Text="Hôm nay bạn chưa phát sinh hay ghi chép khoản chi tiêu nào sao? Hãy dành ra 30 giây để cập nhật ví của mình nhé!"
                       TextWrapping="Wrap"
                       Foreground="#4A5568"
                       FontSize="13.5"
                       LineHeight="20"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        >
                <Button Content="Để sau"
                        Width="90"
                        Height="32"
                        Click="BtnClose_Click"
                        Background="#EDF2F7"
                        Foreground="#4A5568"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Margin="0,0,10,0">
                    <Button.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="Nhập Ngay"
                        Width="100"
                        Height="32"
                        Click="BtnInputNow_Click"
                        Background="#2E7D32"
                        Foreground="White"
                        FontWeight="SemiBold"
                        BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
