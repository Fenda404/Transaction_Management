<Window x:Class="Transaction_Management.Views.SubViews.ChangeInfomation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Transaction_Management.Views.SubViews"
        mc:Ignorable="d"
        
        Height="220"
        Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Effect>
        <DropShadowEffect BlurRadius="15"
                          Direction="270"
                          RenderingBias="Quality"
                          ShadowDepth="2"
                          Opacity="0.2" />
    </Window.Effect>

    <Border CornerRadius="12"
            Background="White"
            BorderBrush="#E0E0E0"
            BorderThickness="1">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="txtTitle"
                       Text="NHẬP THÔNG TIN MỚI"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="#2E7D32"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,15" />

            <Grid Grid.Row="1"
                  VerticalAlignment="Center">
                <TextBox x:Name="txtInput"
                         Height="40"
                         FontSize="14"
                         VerticalContentAlignment="Center"
                         Padding="10,0"
                         Visibility="Visible" />

                <PasswordBox x:Name="txtPasswordInput"
                             Height="40"
                             FontSize="14"
                             VerticalContentAlignment="Center"
                             Padding="10,0"
                             Visibility="Collapsed" />
            </Grid>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,15,0,0">
                <Button Content="Hủy bỏ"
                        Width="90"
                        Height="35"
                        Background="#F5F5F5"
                        Foreground="#333333"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        Cursor="Hand"
                        Margin="0,0,10,0"
                        Click="Cancel_Click">
                    <Button.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="Xác nhận"
                        Width="90"
                        Height="35"
                        Background="#2E7D32"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        IsDefault="True"
                        Click="Confirm_Click">
                    <Button.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>