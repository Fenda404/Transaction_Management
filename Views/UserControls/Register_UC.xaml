<UserControl x:Class="Transaction_Management.Views.UserControls.Register_UC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Transaction_Management.ViewModels"
             xmlns:cvt="clr-namespace:Transaction_Management.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="1000"
             Background="Transparent">

    <UserControl.DataContext>
        <vm:RegisterViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <cvt:BoolToBrushConverter x:Key="BoolToBrushConverter" />
        <!-- Tái sử dụng Style Nhập liệu từ Login -->
        <Style x:Key="RegisterInputStyle" TargetType="Control">
            <Setter Property="Height" Value="48" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Background" Value="#F8FDF8" />
            <Setter Property="BorderBrush" Value="#A5D6A7" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#4CAF50" />
                    <Setter Property="Background" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style cho Nút bấm chính (Register) -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2E7D32" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1B5E20" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style cho Nút Quay lại (Back) -->
        <ControlTemplate x:Key="BackButtonStyleTemplate" TargetType="Button">
            <Border x:Name="border" Background="Transparent" Padding="5,10">
                <StackPanel Orientation="Horizontal">
                    <Path x:Name="arrowIcon" Data="M 8,0 L 0,8 L 8,16" Stroke="#2E7D32" StrokeThickness="3" StrokeEndLineCap="Round" StrokeStartLineCap="Round" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtBack" Text="Quay lại" Foreground="#2E7D32" VerticalAlignment="Center" FontSize="15" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="arrowIcon" Property="Stroke" Value="#4CAF50" />
                    <Setter TargetName="txtBack" Property="Foreground" Value="#4CAF50" />
                    <Setter Property="Cursor" Value="Hand" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- KHUNG CHỨA REGISTER CĂN GIỮA -->
        <Border Background="White"
                CornerRadius="25"
                Width="500"
                Padding="45,40"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

            <!-- Đổ bóng khung -->
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.08" Color="Black"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- HEADER: Nút Quay lại và Tiêu đề -->
                <Grid Grid.Row="0" Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Template="{StaticResource BackButtonStyleTemplate}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Command="{Binding DataContext.SwitchViewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="Login" />

                    <StackPanel Grid.Column="1" HorizontalAlignment="Center"
                                Grid.ColumnSpan="2">
                        <TextBlock Text="TẠO TÀI KHOẢN"
                                   FontSize="24"
                                   FontWeight="Heavy"
                                   Foreground="#2E7D32"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,5"/>
                        <TextBlock Text="Hãy tham gia ngay!"
                                   Foreground="#757575" 
                                   FontSize="13"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- USERNAME -->
                <StackPanel Grid.Row="1" Margin="0,0,0,18">
                    <TextBlock Text="Username" Foreground="#333333" FontWeight="SemiBold" FontSize="14" Margin="5,0,0,8"/>
                    <TextBox x:Name="txtUsername"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource RegisterInputStyle}"/>
                </StackPanel>

                <!-- PASSWORD -->
                <StackPanel Grid.Row="2" Margin="0,0,0,18">
                    <TextBlock Text="Password" Foreground="#333333" FontWeight="SemiBold" FontSize="14" Margin="5,0,0,8"/>
                    <PasswordBox x:Name="pwbPassword"
                                 Style="{StaticResource RegisterInputStyle}"/>
                    <TextBlock Text="* Tối thiểu 8 ký tự, bao gồm chữ và số"
                               Foreground="#9E9E9E" FontSize="12" Margin="5,6,0,0"/>
                </StackPanel>

                <!-- CONFIRM PASSWORD -->
                <StackPanel Grid.Row="3" Margin="0,0,0,30">
                    <TextBlock Text="Confirm Password" Foreground="#333333" FontWeight="SemiBold" FontSize="14" Margin="5,0,0,8"/>
                    <PasswordBox x:Name="pwbConfirmPass"
                                 Style="{StaticResource RegisterInputStyle}"/>
                </StackPanel>

                <!-- NÚT ĐĂNG KÝ -->
                <Button x:Name="btnRegister"
                        Grid.Row="4"
                        Content="Tạo tài khoản"
                        Height="50"
                        Margin="0,0,0,25"
                        Command="{Binding RegisterCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsDefault="True">
                </Button>

                <!-- FOOTER -->
                <TextBlock Grid.Row="5"
                           Text="© 2026 Team 10. All rights reserved."
                           HorizontalAlignment="Center"
                           Foreground="#9E9E9E"
                           FontSize="12"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>