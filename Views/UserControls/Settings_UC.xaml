<UserControl x:Class="Transaction_Management.Views.UserControls.Settings_UC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Transaction_Management.Converters"
             xmlns:vm="clr-namespace:Transaction_Management.ViewModels"
             Background="Transparent"
             mc:Ignorable="d"
             d:DesignHeight="800"
             Width="1020">

    <UserControl.DataContext>
        <vm:SettingsViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <local:PasswordVisibilityConverter x:Key="PasswordVisibilityConverter" />

        <!-- Style cho tiêu đề nhóm -->
        <Style x:Key="SettingHeaderStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="18" />
            <Setter Property="FontWeight"
                    Value="Bold" />
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryColor}" />
            <Setter Property="Margin"
                    Value="0,15,0,10" />
        </Style>

        <!-- Style cho Card bao quanh nhóm cài đặt -->
        <Style x:Key="SettingCardStyle"
               TargetType="Border">
            <Setter Property="Background"
                    Value="{DynamicResource MainContainerBg}" />
            <Setter Property="CornerRadius"
                    Value="12" />
            <Setter Property="Padding"
                    Value="20" />
            <Setter Property="Margin"
                    Value="0,0,0,20" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource DividerColor}" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10"
                                      ShadowDepth="1"
                                      Opacity="0.08"
                                      Color="Black" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style cho dòng cài đặt lẻ -->
        <Style x:Key="SettingItemStyle"
               TargetType="Grid">
            <Setter Property="Margin"
                    Value="0,12" />
        </Style>

        <!-- Style cho nút hành động nhỏ -->
        <Style x:Key="ActionButtonStyle"
               TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource PrimaryLight}" />
            <Setter Property="BorderThickness"
                    Value="1.5" />
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryColor}" />
            <Setter Property="Padding"
                    Value="15,8" />
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource PrimaryLighter}" />
                                <Setter Property="BorderBrush"
                                        Value="{DynamicResource PrimaryColor}" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource PrimaryLight}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style cho ComboBox -->
        <Style x:Key="SettingComboBoxStyle"
               TargetType="ComboBox">
            <Setter Property="Height"
                    Value="38" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="Padding"
                    Value="12,0" />
            <Setter Property="Background"
                    Value="{DynamicResource MainContainerBg}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource DividerColor}" />
            <Setter Property="BorderThickness"
                    Value="1.5" />
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextGray}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Grid.Column="2"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8"
                                                Padding="12,0">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="4"
                                                                  ShadowDepth="0"
                                                                  Opacity="0.05" />
                                            </Border.Effect>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="25" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  RecognizesAccessKey="True" />
                                                <Path Grid.Column="1"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="{DynamicResource PrimaryColor}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Margin="0,2,0,0" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver"
                                                     Value="True">
                                                <Setter TargetName="Border"
                                                        Property="Background"
                                                        Value="{DynamicResource PrimaryLighter}" />
                                                <Setter TargetName="Border"
                                                        Property="BorderBrush"
                                                        Value="{DynamicResource PrimaryLight}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked"
                                                     Value="True">
                                                <Setter TargetName="Border"
                                                        Property="Background"
                                                        Value="{DynamicResource PrimaryLighter}" />
                                                <Setter TargetName="Border"
                                                        Property="BorderBrush"
                                                        Value="{DynamicResource PrimaryColor}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentPresenter"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Margin="12,0,0,0" />
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      MinWidth="{Binding ActualWidth, ElementName=ToggleButton}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                      Background="{DynamicResource MainContainerBg}"
                                      SnapsToDevicePixels="True">
                                    <Border x:Name="DropDownBorder"
                                            Background="{DynamicResource MainContainerBg}"
                                            BorderBrush="{DynamicResource DividerColor}"
                                            BorderThickness="1.5"
                                            CornerRadius="8"
                                            Padding="4"
                                            Margin="0,4,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10"
                                                              ShadowDepth="2"
                                                              Opacity="0.12"
                                                              Color="Black" />
                                        </Border.Effect>
                                        <ScrollViewer Margin="4"
                                                      SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True"
                                                        KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems"
                                     Value="False">
                                <Setter TargetName="DropDownBorder"
                                        Property="MinHeight"
                                        Value="95" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextGray}" />
                                <Setter Property="Opacity"
                                        Value="0.5" />
                            </Trigger>
                            <Trigger Property="IsGrouping"
                                     Value="True">
                                <Setter Property="ScrollViewer.CanContentScroll"
                                        Value="False" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding"
                                Value="12,8" />
                        <Setter Property="Foreground"
                                Value="{DynamicResource TextGray}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd"
                                            Background="Transparent"
                                            Padding="{TemplateBinding Padding}"
                                            CornerRadius="4">
                                        <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted"
                                                 Value="True">
                                            <Setter TargetName="Bd"
                                                    Property="Background"
                                                    Value="{DynamicResource PrimaryLighter}" />
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource PrimaryColor}" />
                                            <Setter Property="FontWeight"
                                                    Value="SemiBold" />
                                        </Trigger>
                                        <Trigger Property="IsSelected"
                                                 Value="True">
                                            <Setter TargetName="Bd"
                                                    Property="Background"
                                                    Value="{DynamicResource PrimaryLight}" />
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource PrimaryDark}" />
                                            <Setter Property="FontWeight"
                                                    Value="Bold" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style cho CheckBox -->
        <Style x:Key="SettingCheckBoxStyle"
               TargetType="CheckBox">
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryColor}" />
        </Style>

        <!-- Color Picker Style -->
        <Style x:Key="ColorButtonStyle"
               TargetType="Button">
            <Setter Property="Width"
                    Value="50" />
            <Setter Property="Height"
                    Value="50" />
            <Setter Property="Margin"
                    Value="5" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                BorderBrush="{DynamicResource DividerColor}"
                                BorderThickness="2">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="5"
                                                  ShadowDepth="1"
                                                  Opacity="0.1" />
                            </Border.Effect>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="8"
                                                          ShadowDepth="2"
                                                          Opacity="0.15" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,5,0">
        <ScrollViewer.Resources>
            <Style TargetType="ScrollBar"
                   BasedOn="{StaticResource CustomScrollBarStyle}" />
        </ScrollViewer.Resources>
        <Grid Margin="30,20"
              MaxWidth="1200">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- TIÊU ĐỀ TRANG -->
            <Border Grid.Row="0"
                    Background="{DynamicResource MainContainerBg}"
                    Padding="20"
                    CornerRadius="12"
                    Margin="0,0,0,25"
                    BorderBrush="{DynamicResource DividerColor}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="⚙️ CÀI ĐẶT HỆ THỐNG"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryColor}" />
                    <TextBlock Text="Tùy chỉnh trải nghiệm cá nhân của bạn"
                               Foreground="{DynamicResource TextGray}"
                               FontSize="14"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- 1. THÔNG TIN NGƯỜI DÙNG -->
            <StackPanel Grid.Row="1">
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,12">
                    <TextBlock Text="👤"
                               FontSize="24"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="1. Thông tin người dùng"
                               Style="{StaticResource SettingHeaderStyle}" />
                </StackPanel>
                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingItemStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Tên người dùng"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Foreground="{DynamicResource PrimaryDark}" />
                                <TextBlock Text="{Binding Username}"
                                           Foreground="{DynamicResource TextGray}"
                                           FontSize="12"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Đổi Username"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Command="{Binding ChangeUsernameCommand}" />
                        </Grid>
                        <Separator Background="{DynamicResource DividerColor}"
                                   Margin="-20,10,-20,10" />
                        <Grid Style="{StaticResource SettingItemStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Mật khẩu"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Foreground="{DynamicResource PrimaryDark}" />
                                <TextBlock Text="{Binding UserPassword}"
                                           Foreground="{DynamicResource TextGray}"
                                           FontSize="12"
                                           Margin="0,4,0,0"
                                           FontFamily="Courier New" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="0,0,0,0">
                                <Button Style="{StaticResource ActionButtonStyle}"
                                        Command="{Binding TogglePasswordVisibilityCommand}"
                                        Width="45"
                                        Height="40"
                                        Padding="0"
                                        ToolTip="Hiện/Ẩn mật khẩu"
                                        Margin="0,0,8,0">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="{Binding IsPasswordVisible, Converter={StaticResource PasswordVisibilityConverter}, ConverterParameter=icon}"
                                               FontSize="16" />
                                </Button>
                                <Button Content="Đổi mật khẩu"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Command="{Binding ChangePasswordCommand}" />
                            </StackPanel>
                        </Grid>

                        <!-- Cập nhật Email -->
                        <StackPanel>
                            <TextBlock Text="Email"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Foreground="{DynamicResource PrimaryDark}"
                                       Margin="0,12,0,4" />
                            <TextBox x:Name="txtEmail"
                                     Height="40"
                                     FontSize="14"
                                     VerticalContentAlignment="Center"
                                     Padding="10,0"
                                     Background="{DynamicResource MainContainerBg}"
                                     Foreground="{DynamicResource TextGray}"
                                     BorderBrush="{DynamicResource DividerColor}"
                                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return"
                                                Command="{Binding SaveEmailCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </StackPanel>

                        <!-- Cập nhật tên đầy đủ -->
                        <StackPanel>
                            <TextBlock Text="Họ và tên"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Foreground="{DynamicResource PrimaryDark}"
                                       Margin="0,12,0,4" />
                            <TextBox x:Name="txtFullname"
                                     Height="40"
                                     FontSize="14"
                                     VerticalContentAlignment="Center"
                                     Padding="10,0"
                                     Background="{DynamicResource MainContainerBg}"
                                     Foreground="{DynamicResource TextGray}"
                                     BorderBrush="{DynamicResource DividerColor}"
                                     Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return"
                                                Command="{Binding SaveFullNameCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 2. TIỀN TỆ -->
            <StackPanel Grid.Row="2">
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,12">
                    <TextBlock Text="💵"
                               FontSize="24"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="2. Tiền tệ"
                               Style="{StaticResource SettingHeaderStyle}" />
                </StackPanel>
                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid Style="{StaticResource SettingItemStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Loại tiền tệ sử dụng"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Foreground="{DynamicResource PrimaryDark}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding Currencies}"
                                  SelectedItem="{Binding SelectedCurrency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource SettingComboBoxStyle}" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- 3. GIAO DIỆN & MÀU SẮC -->
            <StackPanel Grid.Row="3">
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,12">
                    <TextBlock Text="🎨"
                               FontSize="24"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="3. Giao diện &amp; Màu sắc"
                               Style="{StaticResource SettingHeaderStyle}" />
                </StackPanel>
                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingItemStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Chế độ tối (Dark Mode)"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Foreground="{DynamicResource PrimaryDark}"
                                       VerticalAlignment="Center" />
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding IsDarkMode, Mode=TwoWay}"
                                      Style="{StaticResource SettingCheckBoxStyle}" />
                        </Grid>
                        <Separator Background="{DynamicResource DividerColor}"
                                   Margin="-20,10,-20,10" />

                        <!-- Chọn Màu Chủ Đạo -->
                        <Grid Style="{StaticResource SettingItemStyle}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Chọn màu chủ đạo"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Foreground="{DynamicResource PrimaryDark}" />
                            <WrapPanel Grid.Row="1"
                                       Margin="0,12,0,0">
                                <!-- Xanh Lá (Mặc định) -->
                                <Button Style="{StaticResource ColorButtonStyle}"
                                        Background="#2E7D32"
                                        ToolTip="Xanh Lá"
                                        Command="{Binding ChangeThemeColorCommand}"
                                        CommandParameter="0" />
                                <!-- Xanh Dương -->
                                <Button Style="{StaticResource ColorButtonStyle}"
                                        Background="#1976D2"
                                        ToolTip="Xanh Dương"
                                        Command="{Binding ChangeThemeColorCommand}"
                                        CommandParameter="1" />
                                <!-- Đỏ -->
                                <Button Style="{StaticResource ColorButtonStyle}"
                                        Background="#C62828"
                                        ToolTip="Đỏ"
                                        Command="{Binding ChangeThemeColorCommand}"
                                        CommandParameter="2" />
                            </WrapPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 4. THÔNG BÁO -->
            <StackPanel Grid.Row="4">
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,12">
                    <TextBlock Text="🔔"
                               FontSize="24"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="4. Thông báo"
                               Style="{StaticResource SettingHeaderStyle}" />
                </StackPanel>
                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingItemStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Cảnh báo khi vượt ngân sách"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Foreground="{DynamicResource PrimaryDark}"
                                       VerticalAlignment="Center" />
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding IsBudgetAlert}"
                                      Style="{StaticResource SettingCheckBoxStyle}" />
                        </Grid>
                        <Separator Background="{DynamicResource DividerColor}"
                                   Margin="-20,10,-20,10" />
                        <Grid Style="{StaticResource SettingItemStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Nhắc nhập chi tiêu hàng ngày"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Foreground="{DynamicResource PrimaryDark}"
                                       VerticalAlignment="Center" />
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding IsDailyReminder}"
                                      Style="{StaticResource SettingCheckBoxStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 5. XÓA TẤT CẢ GIAO DỊCH -->
            <StackPanel Grid.Row="5">
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,12">
                    <TextBlock Text="✖"
                               FontSize="24"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="5. Xóa tất cả giao dịch"
                               Style="{StaticResource SettingHeaderStyle}" />
                </StackPanel>
                <Border Style="{StaticResource SettingCardStyle}">
                    <Button Content="Xóa tất cả các giao dịch hiện tại"
                            Command="{Binding DeleteAllTransactionCommand}"
                            Background="SaddleBrown"
                            Foreground="White"
                            BorderBrush="RosyBrown"
                            BorderThickness="1.5"
                            Height="45"
                            FontWeight="Bold"
                            FontSize="14"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center">
                                        <TextBlock Text="🗑️"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0"
                                                   FontSize="16" />
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter Property="Opacity"
                                                Value="0.8" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Border>
            </StackPanel>

            <!-- 6. BẢO MẬT -->
            <StackPanel Grid.Row="6">
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,12">
                    <TextBlock Text="🔐"
                               FontSize="24"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="6. Bảo mật"
                               Style="{StaticResource SettingHeaderStyle}" />
                </StackPanel>
                <Border Style="{StaticResource SettingCardStyle}">
                    <Button Content="Đăng xuất khỏi thiết bị này"
                            Command="{Binding SignOutCommand}"
                            Background="#FFEBEE"
                            Foreground="#D32F2F"
                            BorderBrush="#EF9A9A"
                            BorderThickness="1.5"
                            Height="45"
                            FontWeight="Bold"
                            FontSize="14"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center">
                                        <TextBlock Text="🚪"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0"
                                                   FontSize="16" />
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter Property="Background"
                                                Value="#FFCDD2" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>