<UserControl x:Class="Transaction_Management.Views.UserControls.Transactions_UC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">

    <UserControl.Resources>
        <!-- Style cho thanh tìm kiếm -->
        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="45" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Background" Value="#F1F8E9" />
            <Setter Property="BorderBrush" Value="#4CAF50" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Padding" Value="40,0,10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="20">
                                <Grid>
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#2E7D32" 
                                               FontSize="18" Margin="15,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                               IsHitTestVisible="False" Opacity="0.6"/>
                                    <ScrollViewer x:Name="PART_ContentHost" Margin="0" />
                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style cho Nút Thêm mới -->
        <Style x:Key="AddButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2E7D32" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Height" Value="45" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="20">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <ContentPresenter />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1B5E20" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Tiêu đề và Search -->
            <RowDefinition Height="*" />
            <!-- Bảng dữ liệu -->
        </Grid.RowDefinitions>

        <!-- PHẦN ĐẦU: TIÊU ĐỀ & CÔNG CỤ -->
        <Grid Grid.Row="0" Margin="0,0,0,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Transaction History" FontSize="28" FontWeight="Bold" Foreground="#2E7D32" />
                <TextBlock Text="Manage and track your financial activities" Foreground="#757575" FontSize="14" />
            </StackPanel>

            <!-- Ô Tìm kiếm -->
            <TextBox Grid.Column="1" Width="300" Style="{StaticResource SearchTextBoxStyle}" 
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                     Tag="Search by description or category..." Margin="0,0,15,0"/>

            <!-- Nút Thêm mới -->
            <Button Grid.Column="2" Content="NEW TRANSACTION" Style="{StaticResource AddButtonStyle}" 
                    Command="{Binding AddTransactionCommand}" />
        </Grid>

        <!-- PHẦN THÂN: BẢNG GIAO DỊCH -->
        <Border Grid.Row="1" Background="White" CornerRadius="20" BorderBrush="#E8F5E9" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.05" Color="Black" />
            </Border.Effect>

            <DataGrid ItemsSource="{Binding FilteredTransactions}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      Background="Transparent"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F1F1F1"
                      RowHeight="55"
                      HeadersVisibility="Column"
                      IsReadOnly="True">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="#2E7D32" />
                        <Setter Property="FontWeight" Value="Bold" />
                        <Setter Property="FontSize" Value="14" />
                        <Setter Property="Padding" Value="15,10" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="BorderBrush" Value="#E8F5E9" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F1F8E9" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="DATE" Binding="{Binding Date, StringFormat=dd/MM/yyyy HH:mm}" Width="180" />
                    <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*" />
                    <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="150" />

                    <!-- Cột Số tiền với màu sắc động (Xanh/Đỏ) -->
                    <DataGridTemplateColumn Header="AMOUNT" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Amount, StringFormat={}{0:N0} đ}" 
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" 
                                           HorizontalAlignment="Right" 
                                           Margin="0,0,15,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="Income">
                                                    <Setter Property="Foreground" Value="#4CAF50" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="Expense">
                                                    <Setter Property="Foreground" Value="#D32F2F" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Nút hành động -->
                    <DataGridTemplateColumn Header="ACTIONS" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" Background="Transparent" BorderThickness="0" Foreground="#4CAF50" Cursor="Hand" Margin="5,0"/>
                                    <Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Background="Transparent" BorderThickness="0" Foreground="#D32F2F" Cursor="Hand" Margin="5,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>