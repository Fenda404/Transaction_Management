<UserControl x:Class="Transaction_Management.Views.UserControls.Dashboard_UC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Transaction_Management.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900">

    
    
    
    
    <UserControl.Resources>
        <!-- Style cho các thẻ Thống kê (Cards) -->
        <Style x:Key="DashboardCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="Margin" Value="10" />
            <Setter Property="Padding" Value="25" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="#4CAF50" />
            <!-- Viền xanh lá -->
            <Setter Property="Background" Value="#F8FDF8" />
            <!-- Nền xanh lá cực nhạt -->
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.08" Color="Black" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style cho Tiêu đề thẻ -->
        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#2E7D32" />
            <!-- Chữ xanh lá đậm -->
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <!-- Style cho Giá trị thẻ -->
        <Style x:Key="CardValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1B5E20" />
            <Setter Property="FontSize" Value="32" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontFamily" Value="Cascadia Mono" />
        </Style>

        <!-- Style cho Header của Bảng dữ liệu (DataGrid) -->
        <Style x:Key="DashboardDataGridStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#4CAF50" />
            <!-- Nền xanh lá -->
            <Setter Property="Foreground" Value="White" />
            <!-- Chữ trắng -->
            <Setter Property="Padding" Value="15,12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="BorderBrush" Value="#388E3C" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <UserControl.DataContext>
        <vm:DashboardViewModel />
    </UserControl.DataContext>

    <!-- Phần Grid chính của Dashboard -->
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- HÀNG 1: 3 THẺ TỔNG QUAN -->
        <UniformGrid Columns="3" Grid.Row="0" Margin="0,0,0,25">
            <!-- Thẻ Tổng số dư -->
            <Border Style="{StaticResource DashboardCardStyle}">
                <StackPanel>
                    <TextBlock Text="TỔNG TIỀN" Style="{StaticResource CardTitleStyle}" />
                    <!-- StringFormat {0:N0} giúp định dạng số tiền có dấu phẩy: 15,000,000 -->
                    <TextBlock Text="{Binding GetTotalBalance, StringFormat={}{0:N0} đ}" Style="{StaticResource CardValueStyle}" />
                </StackPanel>
            </Border>

            <!-- Thẻ Thu nhập -->
            <Border Style="{StaticResource DashboardCardStyle}">
                <StackPanel>
                    <TextBlock Text="THU NHẬP THÁNG" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock Text="{Binding MonthlyIncome, StringFormat={}{0:N0} đ}" Style="{StaticResource CardValueStyle}" />
                </StackPanel>
            </Border>

            <!-- Thẻ Chi phí -->
            <Border Style="{StaticResource DashboardCardStyle}">
                <StackPanel>
                    <TextBlock Text="CHI TIÊU THÁNG" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock Text="{Binding MonthlyExpense, StringFormat={}{0:N0} đ}" Style="{StaticResource CardValueStyle}" Foreground="#D32F2F" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- HÀNG 2: BẢNG GIAO DỊCH GẦN ĐÂY -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#A5D6A7"
                BorderThickness="2"
                CornerRadius="15"
                ClipToBounds="True"
                Margin="10,0,10,10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.05" Color="Black" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="GIAO DỊCH GẦN ĐÂY" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           Foreground="#2E7D32" 
                           Margin="20,15,0,15"/>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding RecentTransactions}"
                          CanUserAddRows="False"
                          CanUserReorderColumns="False"
                          AutoGenerateColumns="False"
                          Background="White"
                          Foreground="Black"
                          RowBackground="White"
                          AlternatingRowBackground="#F1F8E9"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E0E0E0"
                          HeadersVisibility="Column"
                          IsReadOnly="True"
                          RowHeight="45"
                          FontSize="14"
                          ColumnHeaderStyle="{StaticResource DashboardDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="NGÀY"
                                            Binding="{Binding Date, StringFormat=dd/MM/yyyy}"
                                            Width="150" />

                        <DataGridTextColumn Header="GHI CHÚ"
                                            Binding="{Binding Description}"
                                            Width="*" />

                        <!-- Cột số tiền căn phải -->
                        <DataGridTextColumn Header="SỐ TIỀN"
                                            Binding="{Binding Amount, StringFormat={}{0:N0} đ}"
                                            Width="200">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="Padding" Value="0,0,15,0" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>