<UserControl x:Class="Transaction_Management.Views.UserControls.Dashboard_UC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Transaction_Management.ViewModels"
             xmlns:cvt="clr-namespace:Transaction_Management.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900">

    <UserControl.Resources>
        <cvt:CurrencyConverter x:Key="CurrencyConverter" />

        <SolidColorBrush x:Key="DangerColor"
                         Color="#D32F2F" />

        <Style x:Key="DashboardCardStyle"
               TargetType="Border">
            <Setter Property="CornerRadius"
                    Value="16" />
            <Setter Property="Margin"
                    Value="8" />
            <Setter Property="Padding"
                    Value="20,16" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource DividerColor}" />
            <Setter Property="Background"
                    Value="{DynamicResource MainContainerBg}" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12"
                                      ShadowDepth="1"
                                      Opacity="0.06"
                                      Color="Black" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardTitleStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource TextGray}" />
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="FontFamily"
                    Value="Segoe UI" />
            <Setter Property="Margin"
                    Value="0,0,0,6" />
            <Setter Property="TextWrapping"
                    Value="Wrap" />
        </Style>

        <Style x:Key="CardValueStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize"
                    Value="32" />
            <Setter Property="FontWeight"
                    Value="Bold" />
            <Setter Property="FontFamily"
                    Value="Segoe UI" />
            <Setter Property="TextWrapping"
                    Value="Wrap" />
        </Style>

        <Style x:Key="DashboardDataGridStyle"
               TargetType="DataGridColumnHeader">
            <Setter Property="Background"
                    Value="{DynamicResource PrimaryColor}" />
            <Setter Property="Foreground"
                    Value="White" />
            <Setter Property="Padding"
                    Value="16,12" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource PrimaryLight}" />
            <Setter Property="BorderThickness"
                    Value="0,0,1,0" />
            <Setter Property="Height"
                    Value="44" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background"
                    Value="{DynamicResource MainContainerBg}" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex"
                         Value="0">
                    <Setter Property="Background"
                            Value="{DynamicResource MainContainerBg}" />
                </Trigger>
                <Trigger Property="ItemsControl.AlternationIndex"
                         Value="1">
                    <Setter Property="Background"
                            Value="{DynamicResource PrimaryLighter}" />
                </Trigger>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource PrimaryLight}" />
                    <Setter Property="Foreground"
                            Value="White" />
                    <Setter Property="Cursor"
                            Value="Hand" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <UserControl.DataContext>
        <vm:DashboardViewModel />
    </UserControl.DataContext>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <UniformGrid Grid.Row="0"
                     Columns="3"
                     Margin="0,0,0,24">

            <Border Style="{StaticResource DashboardCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Width="48"
                            Height="48"
                            CornerRadius="12"
                            Background="{DynamicResource PrimaryLighter}"
                            Margin="0,0,16,0">
                        <TextBlock Text="💰"
                                   FontSize="24"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="TỔNG SỐ DƯ"
                                   Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="{Binding GetTotalBalance, Converter={StaticResource CurrencyConverter}}"
                                   Style="{StaticResource CardValueStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource DashboardCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Width="48"
                            Height="48"
                            CornerRadius="12"
                            Background="{DynamicResource PrimaryLighter}"
                            Margin="0,0,16,0">
                        <TextBlock Text="📈"
                                   FontSize="24"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="THU NHẬP THÁNG"
                                   Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="{Binding GetMonthlyIncome, Converter={StaticResource CurrencyConverter}}"
                                   Style="{StaticResource CardValueStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource DashboardCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Width="48"
                            Height="48"
                            CornerRadius="12"
                            Background="{DynamicResource PrimaryLighter}"
                            Margin="0,0,16,0">
                        <TextBlock Text="📉"
                                   FontSize="24"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="CHI TIÊU THÁNG"
                                   Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="{Binding GetMonthlyExpense, Converter={StaticResource CurrencyConverter}}"
                                   Style="{StaticResource CardValueStyle}"
                                   Foreground="{StaticResource DangerColor}" />
                    </StackPanel>
                </Grid>
            </Border>
        </UniformGrid>

        <Border Grid.Row="1"
                Background="{DynamicResource MainContainerBg}"
                CornerRadius="16"
                BorderThickness="1"
                BorderBrush="{DynamicResource DividerColor}"
                Margin="0,0,0,8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12"
                                  ShadowDepth="1"
                                  Opacity="0.05"
                                  Color="Black" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource DividerColor}"
                        Padding="20,14">
                    <TextBlock Text="GIAO DỊCH GẦN ĐÂY TRONG THÁNG NÀY"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryColor}" />
                </Border>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding RecentTransactions}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserReorderColumns="False"
                          CanUserSortColumns="True"
                          HeadersVisibility="Column"
                          IsReadOnly="True"
                          RowHeight="48"
                          AlternationCount="2"
                          Background="Transparent"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource DividerColor}"
                          ColumnHeaderStyle="{StaticResource DashboardDataGridStyle}">
                    <DataGrid.Resources>
                        <Style TargetType="ScrollViewer">
                            <Style.Resources>
                                <Style TargetType="ScrollBar"
                                       BasedOn="{StaticResource CustomScrollBarStyle}" />
                            </Style.Resources>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="NGÀY"
                                            Binding="{Binding TransactionDate, StringFormat=dd/MM/yyyy}"
                                            Width="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding"
                                            Value="16,0" />
                                    <Setter Property="VerticalAlignment"
                                            Value="Center" />
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextPrimary}" />
                                    <Setter Property="FontSize"
                                            Value="13" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="GHI CHÚ"
                                            Binding="{Binding Note}"
                                            Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding"
                                            Value="16,0" />
                                    <Setter Property="VerticalAlignment"
                                            Value="Center" />
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextPrimary}" />
                                    <Setter Property="FontSize"
                                            Value="13" />
                                    <Setter Property="FontWeight"
                                            Value="Medium" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="SỐ TIỀN"
                                            Binding="{Binding Amount, Converter={StaticResource CurrencyConverter}}"
                                            Width="200">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding"
                                            Value="16,0" />
                                    <Setter Property="VerticalAlignment"
                                            Value="Center" />
                                    <Setter Property="HorizontalAlignment"
                                            Value="Right" />
                                    <Setter Property="FontWeight"
                                            Value="SemiBold" />
                                    <Setter Property="FontSize"
                                            Value="13" />
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextPrimary}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>