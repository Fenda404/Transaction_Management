<UserControl x:Class="Transaction_Management.Views.UserControls.Reports_UC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Transaction_Management.ViewModels"
             xmlns:conv="clr-namespace:Transaction_Management.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">

    <UserControl.DataContext>
        <vm:ReportsViewModel />
    </UserControl.DataContext>
    
    <UserControl.Resources>
        <conv:PercentToWidthConverter x:Key="PercentToWidthConverter" />
        
        <!-- Style cho các thẻ báo cáo tổng quát -->
        <Style x:Key="ReportCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="25" />
            <Setter Property="Margin" Value="10" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E8F5E9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.05" Color="Black" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style cho văn bản tiêu đề nhỏ trong thẻ -->
        <Style x:Key="CardSubTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Tiêu đề trang -->
            <RowDefinition Height="Auto" />
            <!-- Các thẻ tóm tắt -->
            <RowDefinition Height="*" />
            <!-- Danh sách chi tiết hạng mục -->
        </Grid.RowDefinitions>

        <!-- 1. TIÊU ĐỀ TRANG -->
        <StackPanel Grid.Row="0" Margin="10,0,0,20">
            <TextBlock Text="BÁO CÁO TÀI CHÍNH" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="#2E7D32" />
            <TextBlock Text="Xem lại chi tiết các khoản thu chi và phân tích ngân sách" 
                       Foreground="#757575" 
                       FontSize="14" />
        </StackPanel>

        <!-- 2. CÁC THẺ TÓM TẮT (Income, Expense, Savings) -->
        <UniformGrid Grid.Row="1" Columns="3">
            <Border Style="{StaticResource ReportCardStyle}">
                <StackPanel>
                    <TextBlock Text="TỔNG THU NHẬP" Style="{StaticResource CardSubTitleStyle}" Foreground="#4CAF50"/>
                    <TextBlock Text="{Binding TotalIncome, StringFormat={}{0:N0} đ}" 
                               FontSize="30" 
                               FontWeight="Bold" 
                               Foreground="#1B5E20"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ReportCardStyle}">
                <StackPanel>
                    <TextBlock Text="TỔNG CHI TIÊU" Style="{StaticResource CardSubTitleStyle}" Foreground="#D32F2F"/>
                    <TextBlock Text="{Binding TotalExpense, StringFormat={}{0:N0} đ}" 
                               FontSize="30" 
                               FontWeight="Bold" 
                               Foreground="#B71C1C"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ReportCardStyle}">
                <StackPanel>
                    <TextBlock Text="TIẾT KIỆM RÒNG" Style="{StaticResource CardSubTitleStyle}" Foreground="#2E7D32"/>
                    <TextBlock Text="{Binding NetSavings, StringFormat={}{0:N0} đ}" 
                               FontSize="30" 
                               FontWeight="Bold" 
                               Foreground="#1B5E20"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 3. PHÂN TÍCH CHI TIÊU THEO HẠNG MỤC -->
        <Border Grid.Row="2" Style="{StaticResource ReportCardStyle}" Margin="10,15,10,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Phân tích chi phí theo danh mục" 
                           FontSize="18" 
                           FontWeight="Bold" 
                           Foreground="#2E7D32" 
                           Margin="0,0,0,25"/>

                <!-- Danh sách các hạng mục -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding CategoryBreakdown}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,25">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Tên hạng mục -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                        <Border Width="12" Height="12" Background="{Binding ColorCode}" CornerRadius="6" Margin="0,0,12,0"/>
                                        <TextBlock Text="{Binding CategoryName}" FontSize="15" FontWeight="SemiBold" Foreground="#333333"/>
                                    </StackPanel>

                                    <!-- Giá trị và Phần trăm -->
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="{Binding Amount, StringFormat={}{0:N0} đ}" FontSize="15" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,15,0"/>
                                        <TextBlock Text="{Binding Percentage, StringFormat={}{0}%}" FontSize="15" FontWeight="Bold" Foreground="#2E7D32"/>
                                    </StackPanel>

                                    <!-- Thanh ProgressBar giả lập -->
                                    <Border Grid.Row="1" Grid.ColumnSpan="2" Height="10" Background="#F1F8E9" CornerRadius="5" Margin="0,10,0,0">
                                        <Grid HorizontalAlignment="Left">
                                            <!-- Chú ý: Chiều rộng này phụ thuộc vào Percentage (Cần Converter hoặc bind trực tiếp nếu tính toán sẵn) -->
                                            <!-- Thay vì Width="350" cứng -->
                                            <Border Background="{Binding ColorCode}"
                                                    CornerRadius="5"
                                                    Width="{Binding Percentage, Converter={StaticResource PercentToWidthConverter}, ConverterParameter=400}" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>