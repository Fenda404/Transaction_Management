<UserControl x:Class="Transaction_Management.Views.UserControls.Login_UC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="650"
             d:DesignWidth="1000"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Style Tùy chỉnh cho TextBox và PasswordBox -->
        <Style x:Key="LoginInputStyle" TargetType="Control">
            <Setter Property="Height" Value="48" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Background" Value="#F8FDF8" />
            <!-- Xanh lá siêu nhạt -->
            <Setter Property="BorderBrush" Value="#A5D6A7" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <!-- Bo góc mềm mại -->
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Hiệu ứng khi nhấp chuột vào ô nhập liệu -->
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#4CAF50" />
                    <Setter Property="Background" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style cho Nút bấm chính (Login) -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2E7D32" />
            <!-- Xanh lá đậm -->
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1B5E20" />
                                <!-- Đậm hơn khi Hover -->
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style cho Nút bấm phụ (Register) -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#2E7D32" />
            <Setter Property="BorderBrush" Value="#2E7D32" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E8F5E9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- KHUNG CHỨA LOGIN CĂN GIỮA -->
        <Border Background="White"
                CornerRadius="25"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Width="480"
                Padding="45,40">
            <!-- Đổ bóng làm nổi bật khung -->
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.08" Color="Black" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- TIÊU ĐỀ -->
                <StackPanel Grid.Row="0" Margin="0,0,0,35">
                    <TextBlock Text="CHÀO MỪNG TRỞ LẠI"
                               HorizontalAlignment="Center"
                               Foreground="#2E7D32" 
                               FontSize="30"
                               FontWeight="Heavy" 
                               Margin="0,0,0,5" />
                    <TextBlock Text="Vui lòng nhập thông tin để đăng nhập"
                               HorizontalAlignment="Center"
                               Foreground="#757575" 
                               FontSize="14" />
                </StackPanel>

                <!-- Ô NHẬP USERNAME -->
                <StackPanel Grid.Row="1" Margin="0,0,0,20">
                    <TextBlock Text="Username" Foreground="#333333" FontWeight="SemiBold" FontSize="14" Margin="5,0,0,8" />
                    <TextBox x:Name="txtUsername"
                             Text="{Binding Username}"
                             Style="{StaticResource LoginInputStyle}" />
                </StackPanel>

                <!-- Ô NHẬP PASSWORD -->
                <StackPanel Grid.Row="2" Margin="0,0,0,10">
                    <TextBlock Text="Password" Foreground="#333333" FontWeight="SemiBold" FontSize="14" Margin="5,0,0,8" />
                    <PasswordBox x:Name="pwbPassword"
                                 Style="{StaticResource LoginInputStyle}" />
                </StackPanel>

                <!-- QUÊN MẬT KHẨU -->
                <Button x:Name="btnForgetPass"
                        Content="Quên mật khẩu?"
                        Grid.Row="3"
                        HorizontalAlignment="Right"
                        Foreground="#4CAF50" 
                        Cursor="Hand"
                        Background="Transparent"
                        BorderThickness="0"
                        Margin="0,0,0,35">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <TextBlock Text="{TemplateBinding Content}" x:Name="txtFP" Foreground="{TemplateBinding Foreground}" FontWeight="SemiBold"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="txtFP" Property="TextDecorations" Value="Underline" />
                                    <Setter TargetName="txtFP" Property="Foreground" Value="#1B5E20" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- HAI NÚT SIGN IN & SIGN UP -->
                <Grid Grid.Row="4" Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="15" />
                        <!-- Khoảng cách giữa 2 nút -->
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="btnLogin"
                            Content="Đăng nhập"
                            Height="50"
                            Grid.Column="0"
                            Command="{Binding LoginCommand}"
                            CommandParameter="{Binding ElementName=pwbPassword}"
                            Style="{StaticResource PrimaryButtonStyle}" />

                    <Button x:Name="btnRegister"
                            Content="Đăng ký"
                            Height="50"
                            Grid.Column="2"
                            Command="{Binding DataContext.SwitchViewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="Register"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </Grid>

                <!-- FOOTER / COPYRIGHT -->
                <TextBlock Text="© 2026 Team 10. All rights reserved."
                           Grid.Row="5"
                           HorizontalAlignment="Center"
                           Foreground="#9E9E9E" 
                           FontSize="12" />
            </Grid>
        </Border>
    </Grid>
</UserControl>