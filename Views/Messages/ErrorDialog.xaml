<Window x:Class="Transaction_Management.Views.Messages.ErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Transaction_Management.Views.Messages"
        mc:Ignorable="d"
        Height="200"
        Width="350"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Border Background="White"
            CornerRadius="15"
            BorderBrush="#FF5F5F"
            BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15"
                              ShadowDepth="0"
                              Opacity="0.5" />
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Ellipse Fill="#FF5F5F"
                         Width="25"
                         Height="25" />
                <TextBlock Text="!"
                           Foreground="White"
                           FontWeight="Bold"
                           Margin="-15,0,20,0"
                           VerticalAlignment="Center" />
                <TextBlock Text="Caution"
                           FontWeight="Bold"
                           FontSize="16"
                           Foreground="#FF5F5F" />
            </StackPanel>

            <TextBlock x:Name="txtMessage"
                       Grid.Row="1"
                       Text="Notificate here..."
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="14"
                       Foreground="#444" />

            <Button Grid.Row="2"
                    Content="OK"
                    Width="100"
                    Height="30"
                    Background="#FF5F5F"
                    Foreground="White"
                    BorderThickness="0"
                    Click="Button_Click"
                    IsDefault="True">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius"
                                Value="5" />
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Border>
</Window>
