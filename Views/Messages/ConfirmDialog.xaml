<Window x:Class="Transaction_Management.Views.Messages.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Transaction_Management.Views.Messages"
        mc:Ignorable="d"
        Height="200"
        Width="350"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Border Background="White"
            CornerRadius="15"
            BorderBrush="#2E7D32"
            BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15"
                              ShadowDepth="0"
                              Opacity="0.5" />
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Ellipse Fill="#2E7D32"
                         Width="25"
                         Height="25" />
                <TextBlock Text="?"
                           Foreground="White"
                           FontWeight="Bold"
                           Margin="-15,0,20,0"
                           VerticalAlignment="Center" />
                <TextBlock Text="Confirmation"
                           FontWeight="Bold"
                           FontSize="16"
                           Foreground="#2E7D32" />
            </StackPanel>

            <TextBlock x:Name="txtMessage"
                       Grid.Row="1"
                       Text="Do you want to sign out?"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="14"
                       Foreground="#444" />

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Button x:Name="btnYes"
                        Content="Yes"
                        Width="100"
                        Height="30"
                        Background="#2E7D32"
                        Foreground="White"
                        BorderThickness="0"
                        Margin="0,0,10,0"
                        Click="BtnYes_Click"
                        IsDefault="True">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius"
                                    Value="5" />
                        </Style>
                    </Button.Resources>
                </Button>
                <Button x:Name="btnNo"
                        Content="No"
                        Width="100"
                        Height="30"
                        Background="#CCCCCC"
                        Foreground="#333"
                        BorderThickness="0"
                        Click="BtnNo_Click"
                        IsCancel="True">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius"
                                    Value="5" />
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
